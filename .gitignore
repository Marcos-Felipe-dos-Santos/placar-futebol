# Segredos — nunca versionar
.env
.dev.vars
*.local
.secrets/

# Config local do Claude Code. Carrega o e-mail do usuario em regras de
# permissao e e especifica desta maquina. Nome literal, em qualquer diretorio:
# o glob *.local acima NAO casa com isto (o arquivo termina em .json), e
# depender dele foi o que quase versionou o e-mail. Os agentes em
# .claude/agents/ SAO versionados.
settings.local.json
settings.local.json.bak

# Amostras de resposta da API (podem conter dados de conta / volume grande)
live-sample.json
leagues-sample.json
live-pico.json
agenda-sample.json

# Mock local para abrir a pagina sem Worker. Gerado por tools/make-mock.mjs a
# partir das capturas (que tambem nao sao versionadas): derivado, grande e
# regeneravel — as tres razoes para nao versionar.
mock-api.json

# Dependências (o projeto não usa build, mas ferramentas locais podem criar)
node_modules/

live-*.json

.env*
.dev.vars*
live-*.json
agenda-*.json
leagues-*.json
mock-*.json

# Artefatos de ferramenta, nunca versionados.
# .wrangler/ guarda cache de conta do wrangler (id e nome da conta, e o nome
# costuma conter o e-mail). dist/ e a saida de `wrangler deploy --dry-run`.
# Os dois entraram num commit por `git add -A` em 2026-09-07 e foram removidos
# antes do push.
.wrangler/
dist/
